# Copy to server/.env and adjust if needed.
# If you use the included docker-compose, these defaults already work.

DATABASE_URL=postgresql://novora:novora@localhost:5432/novora
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma-separated list of allowed web origins (the Vite dev server + your app)
CORS_ORIGIN=http://localhost:5173

# Optional — real email delivery for the automation engine (leave/expense/payroll
# notifications, overdue invoice + onboarding reminders). Leave unset and the app
# still runs automation fully in-app; it just skips the email step and logs why.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-gmail-app-password
# MAIL_FROM=you@gmail.com

# How often (minutes) the automation scheduler checks for overdue invoices and
# stale onboarding checklists. Default 60.
# AUTOMATION_INTERVAL_MINUTES=60
